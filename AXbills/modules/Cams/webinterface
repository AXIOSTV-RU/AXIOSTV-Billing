#**********************************************************
=head2 cams_main($attr)

=cut
#**********************************************************
sub cams_main {

  my $service_id = '';
  my $cams_object = Cams::Axiostv_cams->new($db, $admin, \%conf, $attr);
  my $service_name = $cams_object->{SERVICE_NAME};

  my $services_list = $Cams->services_list({
    PASSWORD  => '_SHOW',
    LOGIN     => '_SHOW',
    MODULE    => '_SHOW',
    COLS_NAME => 1
  });

  foreach my $record (@$services_list) {
    if ($record->{module} == $service_name) {
      $service_id = $record->{id};
      last;
    }
  }

  if (!$service_id) {
    $html->message('err', $lang{ERROR}, 'Axiostv Cams API service is not configured');
    return 1;
  }

  my $auth_data = $Cams->services_info($service_id);

  my $cameras_table = $html->table({
    width      => '100%',
    caption    => $lang{DEVICES} || $lang{CAMERAS},
    title      => [ "#", $lang{NAME}, $lang{ADDRESS} || 'Адрес', $lang{TYPE} || 'Тип', 'Domophone ID',
      'Monitor ID', 'Panel IP', 'Panel login', 'Panel password', 'Panel type', 'SIP password', 'DTMF',
      $lang{STATUS} || 'Статус', 'Latitude', 'Longitude', $lang{RECORDS} || 'Record days', 'URL', 'Camshot', 'Stream' ],
    ID         => 'CAMERAS_ITEMS',
    DATA_TABLE => 1,
    MENU       => "$lang{ADD}:index=$index&add_form=1:add",
  });

  if (!$auth_data->{URL} || !$auth_data->{LOGIN} || !$auth_data->{PASSWORD}) {
    $html->message('err', $lang{ERROR}, 'Cams API service URL/login/password is not configured');
    print $cameras_table->show();
    return 1;
  }

  my $devices_response = $cams_object->dph_keys_get_devices_list({
    URL      => $auth_data->{URL},
    PASSWORD => $auth_data->{PASSWORD},
    LOGIN    => $auth_data->{LOGIN}
  });

  my $devices = [];
  if (ref $devices_response eq 'HASH') {
    $devices = $devices_response->{devices} || $devices_response->{results} || $devices_response->{data} || [];
  }
  elsif (ref $devices_response eq 'ARRAY') {
    $devices = $devices_response;
  }

  if (ref $devices ne 'ARRAY') {
    $html->message('err', $lang{ERROR}, 'Unexpected Cams API devices_list response');
    print $cameras_table->show();
    return 1;
  }

  foreach my $device (@$devices) {
    next if ref $device ne 'HASH';

    $cameras_table->addrow(
      $device->{device_id} || q{},
      $device->{title} || q{},
      $device->{address} || q{},
      $device->{device_type} || q{},
      defined $device->{domophoneid} ? $device->{domophoneid} : q{},
      defined $device->{monitorid} ? $device->{monitorid} : q{},
      $device->{panelip} || q{},
      $device->{panellogin} || q{},
      $device->{panelpasswd} || q{},
      $device->{paneltype} || q{},
      $device->{sippassword} || q{},
      defined $device->{dtmf} ? $device->{dtmf} : q{},
      $device->{is_active} ? $lang{ENABLE} : $lang{DISABLE},
      $device->{latitude} || q{},
      $device->{longitude} || q{},
      defined $device->{record_days} ? $device->{record_days} : q{},
      $device->{url} || q{},
      $device->{camshot} || q{},
      $device->{stream} || q{},
    );
  }

  print $cameras_table->show();

  return 1;
}

