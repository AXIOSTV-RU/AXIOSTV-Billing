          UID         => $FORM{UID},
          ADD_IDS     => $FORM{add_user_rights_do},
          URL         => $auth_data->{URL},
          PASSWORD    => $auth_data->{PASSWORD},
          LOGIN       => $auth_data->{LOGIN} 
